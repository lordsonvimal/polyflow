# templ codegen output — regenerated by the indexer's ensureTemplGenerated
# from the tracked *.templ sources; never hand-edited, must not be committed.
*_templ.go
# ...but keywalk_templ.go is a hand-written source (the templ KeyWalker), not codegen.
!keywalk_templ.go
