{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "/usr/local/bin/polyflow hook-context-inject",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "/usr/local/bin/polyflow hook-context-inject",
            "type": "command"
          }
        ],
        "matcher": "Read"
      },
      {
        "hooks": [
          {
            "command": "/usr/local/bin/polyflow hook-context-inject",
            "type": "command"
          }
        ],
        "matcher": "Grep"
      },
      {
        "hooks": [
          {
            "command": "/usr/local/bin/polyflow hook-context-inject",
            "type": "command"
          }
        ],
        "matcher": "Edit"
      }
    ]
  }
}
