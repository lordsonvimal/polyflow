% Tier FX (FX.8.33, 2026-09-16) — pure pass-through. All the real resolution
% (viewIndex, controller/layout-chain walk, cross-service component
% barrel-import resolution) happens in the "rails_views" hub
% (internal/factpipe/hub_rails_views.go); this rule only republishes its
% already-resolved facts under each emit relation's name.

rv_file_mint_rel(ID, Label, Service, File, Language, Basename) :-
    rv_file_mint(ID, Label, Service, File, Language, Basename).

rv_file_contains_rel(From, To) :-
    rv_file_contains(From, To).

rv_component_mint_rel(ID, Label, Service, File, Line, EndLine, DataReactClass) :-
    rv_component_mint(ID, Label, Service, File, Line, EndLine, DataReactClass).

rv_renders_rel(From, To, Label, Mechanism, Kind, Spec, Collection, Layout, Component) :-
    rv_renders(From, To, Label, Mechanism, Kind, Spec, Collection, Layout, Component).

rv_component_impl_rel(From, To, Label, Component, Via) :-
    rv_component_impl(From, To, Label, Component, Via).

rv_ledger_rel(Service, File, Line, Name, Kind) :-
    rv_ledger(Service, File, Line, Name, Kind).
