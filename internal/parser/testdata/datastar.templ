package testdata

// appConfigEditScript builds a client-handler string out-of-line, the
// maple-manager idiom: markup references the helper by name, not the literal
// window.maple.X() call.
func appConfigEditScript(gameID string) string {
	return fmt.Sprintf("window.maple.openAppConfigForEdit('%s')", gameID)
}

templ ActionPanel(gameID string, page int) {
	<div>
		// Colon syntax, JSExpression wrapper, concatenated path → POST /play/*/draw
		<button data-on:click={ templ.JSExpression("@post('/play/" + gameID + "/draw')") }>Draw</button>
		// Signal write prefix + concatenated @get
		<button data-on:click={ "$page = " + strconv.Itoa(page) + "; @get('/rows/" + gameID + "')" }>Next</button>
		// Fully static datastar action
		<button data-on:click={ "@post('/play/static/resign')" }>Resign</button>
		// Signal-only handler (no @verb) — must NOT create an http_client node
		<button data-on:click="$flipped = !$flipped">Flip</button>
		// Plain client-side JS call (no @verb) — must create a dom_target
		// node with a resolvable handler, the same as onclick= would.
		<button data-on:click="window.maple.syncAllBaseImages()">Sync</button>
		// Handler built indirectly via a local Go helper function — the
		// attribute never mentions window.maple.X literally.
		<button data-on:click={ fmt.Sprintf("$open = ''; %s", appConfigEditScript(gameID)) }>Edit</button>
		// A client-side prep call THEN a backend @verb action in the same
		// constant attribute — both clauses must survive.
		<form data-on:submit__prevent="window.maple.prepareCreateAppSubmit(); @post('/apps/create', {contentType: 'form'})"></form>
		// A guarded client call wrapped in `if (...) { ... }`, THEN a backend
		// @verb action — the actual action call must win over the guard call.
		<form data-on:submit__prevent="if (window.maple.validateAppConfigForm()) { window.maple.prepareAppConfigSubmit(); @post('/app-configs/save', {contentType: 'form'}) }"></form>
		// Reactive text binding referencing a compound signal expression
		<span data-text="$idx + 1"></span>
		<input data-bind="username"/>
	</div>
}
